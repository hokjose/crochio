---
import { supabase } from "../lib/supabase";
import "../styles/global.css";

// 1. Traemos las categorías con su imagen y nombre
const { data: categorias, error } = await supabase.from("categorias").select(`
    *,
    productos (
      id,
      nombre,
      imagen,
      estado
    )
  `);

if (error) {
  console.error("Error al cargar categorías:", error.message);
}
---

<section
  class="w-full min-h-screen py-16 px-4 flex flex-col items-center justify-center text-center bg-cover bg-center bg-fixed relative"
  style="background-image: linear-gradient(to bottom, rgba(80, 137, 141, 0.85) 0%, rgba(0, 0, 0, 0.4) 100%), url('/imagen/fondo-nav.png');"
>
  {/* Logo o imagen principal de la marca */}
  <div
    class="w-40 h-40 rounded-full overflow-hidden border-4 border-white shadow-2xl mb-5 mx-auto bg-white flex items-center justify-center"
  >
    <img
      src="/imagenes/logo_ultimo.png"
      alt="Crochio Logo"
      class="w-full h-full object-cover"
    />
  </div>

  {/* Título y Subtítulo de bienvenida */}
  <h1
    class="text-4xl md:text-6xl font-extrabold text-white mb-3 drop-shadow-md"
  >
    Sistema Crochio
  </h1>

  <p
    class="max-w-2xl mx-auto text-white/90 text-sm md:text-base leading-relaxed mb-8 drop-shadow"
  >
    Panel de gestión y catálogo oficial para la administración de tus productos
    artesanales.
  </p>

  {/* Botones de acción principales */}
  <div class="flex justify-center gap-4 flex-wrap mb-14">
    <a
      href="catalogo"
      class="bg-white/20 hover:bg-white/30 backdrop-blur-md text-white font-bold py-3.5 px-7 rounded-2xl border border-white/30 transition-all transform hover:-translate-y-1"
    >
      Ver categorías
    </a>
    <div class="mt-8 text-center">
      <a
        href="/aprender"
        class="inline-flex items-center gap-2 bg-white/90 hover:bg-white text-rose-700 font-bold px-6 py-3.5 rounded-2xl shadow-lg transition transform hover:-translate-y-0.5 text-sm md:text-base border border-rose-100"
      >
        🧶 ¿Deseas aprender a tejer desde cero?
      </a>
    </div>
  </div>

  {/* Sección de Pregunta */}
  <div id="categorias" class="scroll-mt-10">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">
      ¿Qué estás buscando?
    </h2>
    <p class="text-gray-500 mb-8 text-sm md:text-base">
      Explora nuestras categorías principales
    </p>
  </div>

  {/* Tarjetas de Categorías Dinámicas con imagen automática de Supabase */}
  <div class="flex items-center gap-4 overflow-x-auto py-2 shadow-[0_4px_20px_rgba(34,197,94,0.18)] rounded-xl">
    {categorias?.map((categoria) => {
  const producto = categoria.productos?.[0];

  return (
    <a
      href="/catalogo"
      class="group relative block w-full overflow-hidden rounded-2xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
    >
      <!-- Imagen con tamaño FIJO -->
      <div class="h-[280px] w-full overflow-hidden bg-gray-100">
        <img
          src={producto?.imagen}
          alt={producto?.nombre || categoria.nombre}
          class="h-[280px] w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </div>

      <!-- Información -->
      <div class="flex h-[72px] items-center justify-between px-5">
        <h3 class="text-lg font-semibold text-gray-800">
          {categoria.nombre}
        </h3>

        <!-- Cuadro de flecha -->
        <span
          class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100 text-gray-700 transition-all duration-300 group-hover:bg-gray-900 group-hover:text-white"
        >
          →
        </span>
      </div>
    </a>
  );
})}
  </div>
</section>
