---
export const prerender = false;
import "/src/styles/global.css";
import MainLayout from "../../layouts/MainLayout.astro";
import { supabase } from "../../lib/supabase";

const { id } = Astro.params;

// Resto de tu código para consultar Supabase...
const { data: producto, error } = await supabase
  .from("productos")
  .select("*, categorias(nombre)")
  .eq("id", id)
  .single();

if (error || !producto) {
  return Astro.redirect("/catalogo");
}

const numeroCelular = "51927927209";
const mensajeBase = `¡Hola! Me encantaron tus tejidos en crochio.aqp 😍. Deseo consultar más detalles sobre el producto: "${producto.nombre}" (Precio: S/. ${producto.precio}). ¿Está disponible? ✨`;
const whatsappUrl = `https://wa.me/${numeroCelular}?text=${encodeURIComponent(mensajeBase)}`;
---

<MainLayout title={`${producto.nombre} | Detalles`}>
  <main class="max-w-6xl mx-auto px-4 py-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-white p-6 md:p-10 rounded-2xl shadow-lg border border-gray-100"
    >
      <div
        class="flex items-center justify-center bg-gray-50 rounded-xl overflow-hidden p-2"
      >
        <img
          src={producto.imagen || producto.url_imagen || "/placeholder.jpg"}
          alt={producto.nombre}
          class="w-full h-auto max-h-[450px] object-cover rounded-xl shadow-md"
        />
      </div>

      <div class="flex flex-col justify-between">
        <div>
          <span
            class="inline-block bg-rose-50 text-rose-600 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide mb-3"
          >
            {producto.categorias?.nombre || "Artesanía"}
          </span>

          <h1 class="text-3xl font-extrabold text-gray-900 mb-2">
            {producto.nombre}
          </h1>

          <p class="text-2xl font-bold text-amber-600 mb-6">
            S/. {producto.precio}
          </p>

          <div class="border-t border-gray-100 pt-4 mb-6">
            <h4 class="font-semibold text-gray-800 mb-2">
              Descripción del producto:
            </h4>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              {producto.descripcion}
            </p>
            <ul class="space-y-2 text-sm text-gray-600">
              {
                producto.stock !== undefined && (
                  <li class="flex items-center gap-2 text-emerald-600 font-medium">
                    📦 Stock disponible: {producto.stock} unidades.
                  </li>
                )
              }
            </ul>
          </div>
        </div>
        <button
          onclick="document.getElementById('modalPago').classList.remove('hidden')"
          class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition"
        >
          Comprar
        </button>

        <!-- MODAL -->
        <div
          id="modalPago"
          class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 px-4"
        >
          <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-xl">
            <h2 class="text-2xl font-bold text-gray-800 mb-4">
              🛒 Realizar compra
            </h2>

            <!-- INFORMACIÓN DE PAGO -->
            <div class="border rounded-xl p-4 mb-4">
              <h3 class="font-bold text-lg mb-2">📱 Yape</h3>

              <p class="text-gray-700">
                Número: a nombre de (tu nombre de yape)
              </p>

              <p class="text-xl font-bold mb-4">974 357 754</p>

              <h3 class="font-bold text-lg mb-2">
                🏦 Depósito / Transferencia
              </h3>

              <p class="text-gray-700">
                Número de cuenta:a nombre de (tu nombre)
              </p>

              <p class="text-xl font-bold break-all">4557881305366272</p>
            </div>

            <!-- DATOS DEL CLIENTE -->
            <div class="space-y-3">
              <div>
                <label class="block text-sm font-medium mb-1"> Nombre </label>

                <input
                  id="nombreCliente"
                  type="text"
                  placeholder="Tu nombre"
                  class="w-full border rounded-lg px-3 py-2"
                />
              </div>

              <div>
                <label class="block text-sm font-medium mb-1"> Celular </label>

                <input
                  id="celularCliente"
                  type="tel"
                  placeholder="Tu número"
                  class="w-full border rounded-lg px-3 py-2"
                />
              </div>

              <div>
                <label class="block text-sm font-medium mb-1">
                  Método de pago
                </label>

                <select
                  id="metodoPago"
                  class="w-full border rounded-lg px-3 py-2"
                >
                  <option value="yape">Yape</option>
                  <option value="deposito">Depósito / Transferencia</option>
                </select>
              </div>

              <!-- COMPROBANTE -->
              <div>
                <label class="block text-sm font-medium mb-1">
                  Comprobante de pago
                </label>

                <input
                  id="comprobante"
                  type="file"
                  accept="image/png,image/jpeg,image/webp"
                  class="w-full border rounded-lg px-3 py-2"
                />

                <p class="text-xs text-gray-500 mt-1">
                  Sube una imagen de tu comprobante.
                </p>
              </div>
            </div>

            <!-- BOTÓN -->
            <button
              id="confirmarCompra"
              class="w-full bg-green-600 text-white py-3 rounded-lg mt-5 hover:bg-green-700"
            >
              Confirmar compra
            </button>

            <button
              onclick="document.getElementById('modalPago').classList.add('hidden')"
              class="w-full bg-gray-800 text-white py-2 rounded-lg mt-2"
            >
              Cancelar
            </button>

            <p id="mensajeCompra" class="text-center text-sm mt-3"></p>
          </div>
        </div>
        <div class="space-y-3 pt-4 border-t border-gray-100">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 bg-[#25d366] hover:bg-[#20ba56] text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-300"
          >
            💬 Consultar por WhatsApp
          </a>

          <div class="text-center pt-2">
            <a
              href="/catalogo"
              class="text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors"
            >
              ← Volver al Catálogo
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
<script>
  import { supabase } from "../../lib/supabase";

  const boton = document.getElementById("confirmarCompra");

  boton?.addEventListener("click", async () => {
    // resto de tu código...
    const nombre = (
      document.getElementById("nombreCliente") as HTMLInputElement
    ).value;

    const celular = (
      document.getElementById("celularCliente") as HTMLInputElement
    ).value;

    const metodo = (document.getElementById("metodoPago") as HTMLSelectElement)
      .value;

    const archivo = (document.getElementById("comprobante") as HTMLInputElement)
      .files?.[0];

    const mensaje = document.getElementById("mensajeCompra");

    if (!nombre || !celular || !archivo) {
      mensaje!.textContent = "⚠️ Completa tus datos y sube el comprobante.";

      return;
    }

    try {
      mensaje!.textContent = "⏳ Subiendo comprobante...";

      // ==========================================
      // VARIABLE DE REFERENCIA DE SUPABASE
      // ==========================================

      const supabaseClient = supabase;

      // ==========================================
      // CREAR NOMBRE ÚNICO PARA LA IMAGEN
      // ==========================================

      const extension = archivo.name.split(".").pop();

      const nombreArchivo = `comprobantes/${Date.now()}-${crypto.randomUUID()}.${extension}`;

      // ==========================================
      // SUBIR IMAGEN A SUPABASE STORAGE
      // ==========================================

      const { error: uploadError } = await supabaseClient.storage
        .from("comprobantes")
        .upload(nombreArchivo, archivo, {
          cacheControl: "3600",
          upsert: false,
          contentType: archivo.type,
        });

      if (uploadError) {
        console.error("ERROR COMPLETO DE SUPABASE:", uploadError);

        mensaje!.textContent = `❌ Error: ${uploadError.message}`;

        return;
      }

      // ==========================================
      // OBTENER URL DE LA IMAGEN
      // ==========================================

      const { data } = supabaseClient.storage
        .from("comprobantes")
        .getPublicUrl(nombreArchivo);

      const urlComprobante = data.publicUrl;

      console.log("URL DEL COMPROBANTE:", urlComprobante);

      mensaje!.textContent = "✅ Comprobante subido correctamente.";

      console.log({
        nombre,
        celular,
        metodo,
        comprobante: urlComprobante,
      });
    } catch (error) {
      console.error(error);

      mensaje!.textContent = "❌ Ocurrió un error.";
    }
  });
</script>
