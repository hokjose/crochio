---
export const prerender = false;
import "/src/styles/global.css";
import MainLayout from "../../layouts/MainLayout.astro";
import { supabase } from "../../lib/supabase";

const { id } = Astro.params;

// Resto de tu código para consultar Supabase...
const { data: producto, error } = await supabase
  .from("productos")
  .select("*, categorias(nombre)")
  .eq("id", id)
  .single();

if (error || !producto) {
  return Astro.redirect("/catalogo");
}

const numeroCelular = "51927927209";
const mensajeBase = `¡Hola! Me encantaron tus tejidos en crochio.aqp 😍. Deseo consultar más detalles sobre el producto: "${producto.nombre}" (Precio: S/. ${producto.precio}). ¿Está disponible? ✨`;
const whatsappUrl = `https://wa.me/${numeroCelular}?text=${encodeURIComponent(mensajeBase)}`;
---

<MainLayout title={`${producto.nombre} | Detalles`}>
  <main class="max-w-6xl mx-auto px-4 py-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-white p-6 md:p-10 rounded-2xl shadow-lg border border-gray-100"
    >
      <div
        class="flex items-center justify-center bg-gray-50 rounded-xl overflow-hidden p-2"
      >
        <img
          src={producto.imagen || producto.url_imagen || "/placeholder.jpg"}
          alt={producto.nombre}
          class="w-full h-auto max-h-[450px] object-cover rounded-xl shadow-md"
        />
      </div>

      <div class="flex flex-col justify-between">
        <div>
          <span
            class="inline-block bg-rose-50 text-rose-600 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide mb-3"
          >
            {producto.categorias?.nombre || "Artesanía"}
          </span>

          <h1 class="text-3xl font-extrabold text-gray-900 mb-2">
            {producto.nombre}
          </h1>

          <p class="text-2xl font-bold text-amber-600 mb-6">
            S/. {producto.precio}
          </p>

          <div class="border-t border-gray-100 pt-4 mb-6">
            <h4 class="font-semibold text-gray-800 mb-2">
              Descripción del producto:
            </h4>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              {producto.descripcion}
            </p>
            <ul class="space-y-2 text-sm text-gray-600">
              {
                producto.stock !== undefined && (
                  <li class="flex items-center gap-2 text-emerald-600 font-medium">
                    📦 Stock disponible: {producto.stock} unidades.
                  </li>
                )
              }
            </ul>
          </div>
        </div>

        <div class="space-y-3 pt-4 border-t border-gray-100">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 bg-[#25d366] hover:bg-[#20ba56] text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-300"
          >
            💬 Consultar por WhatsApp
          </a>

          <div class="text-center pt-2">
            <a
              href="/catalogo"
              class="text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors"
            >
              ← Volver al Catálogo
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
