---
import "/src/styles/global.css";
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { supabase } from "../../lib/supabase";

// 1. Obtener todas las categorías
const { data: categorias, error: errorCat } = await supabase
  .from("categorias")
  .select("*");

// 2. Obtener los productos con el nombre de su categoría asociada
const { data: productos, error: errorProd } = await supabase.from("productos")
  .select(`
    *,
    categorias (nombre)
  `);
---

<MainLayout title="Catálogo | Crochio Artesanías" themeColor="#ff6b6b">
  <html lang="es">
    <body class="bg-gray-50 min-h-screen text-gray-800">
      <header class="bg-white border-b border-gray-100 py-6 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 text-center">
          <h1 class="text-3xl font-bold text-rose-600">CROCHIO</h1>
          <p class="text-sm text-gray-500 mt-1">
            Catálogo oficial de productos artesanales
          </p>
        </div>
      </header>

      <main class="max-w-6xl mx-auto px-4 py-10">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-800">Nuestros Productos</h2>
          <span
            class="text-xs font-semibold text-rose-700 bg-rose-50 px-3 py-1 rounded-full border border-rose-100"
          >
            {productos?.length || 0} disponibles
          </span>
        </div>

        {/* Cuadrícula de productos adaptada con Tailwind */}
        <div
          class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"
        >
          {
            productos?.map((prod) => (
              <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col hover:shadow-md transition">
                {/* Imagen controlada en tamaño (h-48 fija) */}
                <div class="h-48 w-full bg-gray-100 overflow-hidden">
                  {prod.imagen ? (
                    <img
                      src={prod.imagen}
                      alt={prod.nombre}
                      class="w-full h-full object-cover hover:scale-105 transition duration-300"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-gray-400 text-xs">
                      Sin imagen
                    </div>
                  )}
                </div>

                {/* Información del producto */}
                <div class="p-4 flex flex-col flex-grow bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-all">
                  <span class="text-xs font-semibold text-rose-600 bg-rose-50 px-2.5 py-1 rounded-lg w-max mb-2">
                    {prod.categorias?.nombre || "General"}
                  </span>

                  <h3 class="font-bold text-gray-800 text-base mb-1 truncate">
                    {prod.nombre}
                  </h3>
                  <p class="text-gray-500 text-xs mb-4 line-clamp-2">
                    {prod.descripcion}
                  </p>

                  <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-100 mb-3">
                    <span class="text-lg font-bold text-gray-900">
                      S/. {prod.precio}
                    </span>
                    <span class="text-xs text-gray-400 font-medium">
                      Stock: {prod.stock}
                    </span>
                  </div>

                  <a
                    href={`/producto/${prod.id}`}
                    class="w-full text-center bg-amber-600 hover:bg-amber-700 text-white font-medium text-sm py-2.5 px-4 rounded-xl transition-all duration-300 shadow-sm hover:shadow"
                  >
                    Ver Producto ✨
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </main>
    </body>
  </html>
</MainLayout>
